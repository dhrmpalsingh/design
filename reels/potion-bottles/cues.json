 "vo": [
  {
   "t": 0.35,
   "dur": 4.654,
   "file": "vo/00.wav",
   "text": "A king has one thousand bottles for tomorrow's feast. But one of them hides a potion."
  },
  {
   "t": 5.654,
   "dur": 3.714,
   "file": "vo/01.wav",
   "text": "Whoever drinks it gets a bright green tongue, exactly one day later."
  },
  {
   "t": 10.118,
   "dur": 3.952,
   "file": "vo/02.wav",
   "text": "The feast is in twenty four hours, and the king has only ten tasters."
  },
  {
   "t": 14.82,
   "dur": 4.959,
   "file": "vo/03.wav",
   "text": "Each taster can sip from as many bottles as they like, but there's only time for one round."
  },
  {
   "t": 20.529,
   "dur": 2.644,
   "file": "vo/04.wav",
   "text": "How can ten tasters find the one potion bottle?"
  },
  {
   "t": 23.823,
   "dur": 1.495,
   "file": "vo/05.wav",
   "text": "Pause, and comment your plan!"
  },
  {
   "t": 35.168,
   "dur": 6.536,
   "file": "vo/06.wav",
   "text": "The trick is binary. Give the tasters the values one, two, four, eight, and so on, up to five hundred twelve."
  },
  {
   "t": 42.554,
   "dur": 4.788,
   "file": "vo/07.wav",
   "text": "Every bottle number from one to a thousand can be made by adding up some of those values."
  },
  {
   "t": 48.192,
   "dur": 3.636,
   "file": "vo/08.wav",
   "text": "Each taster sips from every bottle whose number uses their value."
  },
  {
   "t": 52.578,
   "dur": 3.862,
   "file": "vo/09.wav",
   "text": "Let's try it with seven bottles, and three tasters: one, two, and four."
  },
  {
   "t": 57.09,
   "dur": 7.891,
   "file": "vo/10.wav",
   "text": "Bottle five is four plus one, so tasters four and one sip it. Bottle six is four plus two. And bottle seven uses all three."
  },
  {
   "t": 65.831,
   "dur": 5.58,
   "file": "vo/11.wav",
   "text": "The next day, tasters one and four have green tongues. Four plus one is five. It's bottle five!"
  },
  {
   "t": 72.461,
   "dur": 5.054,
   "file": "vo/12.wav",
   "text": "With ten tasters, the green tongues can point to any bottle up to one thousand and twenty three."
  },
  {
   "t": 78.365,
   "dur": 3.363,
   "file": "vo/13.wav",
   "text": "The potion is found, and the feast is saved, in just one day."
  },
  {
   "t": 83.178,
   "dur": 2.384,
   "file": "vo/14.wav",
   "text": "Could you have cracked it? Follow for more puzzles!"
  }
 ],
