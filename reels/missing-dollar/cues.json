 "vo": [
  {
   "t": 0.35,
   "dur": 3.625,
   "file": "vo/00.wav",
   "text": "Three friends check into a hotel. The room costs thirty dollars."
  },
  {
   "t": 4.625,
   "dur": 2.328,
   "file": "vo/01.wav",
   "text": "They each pay ten dollars. Thirty in total."
  },
  {
   "t": 7.803,
   "dur": 3.953,
   "file": "vo/02.wav",
   "text": "Later, the manager realizes the room was only twenty five dollars."
  },
  {
   "t": 12.406,
   "dur": 2.762,
   "file": "vo/03.wav",
   "text": "So the bellhop is sent with five dollars to give back."
  },
  {
   "t": 15.918,
   "dur": 5.677,
   "file": "vo/04.wav",
   "text": "But five dollars won't split three ways. So the bellhop keeps two, and gives each friend one dollar back."
  },
  {
   "t": 22.545,
   "dur": 6.878,
   "file": "vo/05.wav",
   "text": "Now each friend has paid nine dollars. Three times nine is twenty seven. Plus the bellhop's two, that's twenty nine."
  },
  {
   "t": 30.273,
   "dur": 2.499,
   "file": "vo/06.wav",
   "text": "They paid thirty. So where did the missing dollar go?"
  },
  {
   "t": 33.422,
   "dur": 1.502,
   "file": "vo/07.wav",
   "text": "Pause, and comment your answer!"
  },
  {
   "t": 44.774,
   "dur": 3.349,
   "file": "vo/08.wav",
   "text": "Here's the twist: no dollar is missing. The math is the trick."
  },
  {
   "t": 48.873,
   "dur": 4.014,
   "file": "vo/09.wav",
   "text": "The twenty seven dollars the friends paid already includes the bellhop's two."
  },
  {
   "t": 53.737,
   "dur": 4.499,
   "file": "vo/10.wav",
   "text": "Twenty five went to the hotel, and two went to the bellhop. That's the twenty seven."
  },
  {
   "t": 59.086,
   "dur": 2.36,
   "file": "vo/11.wav",
   "text": "So adding the bellhop's two again counts it twice."
  },
  {
   "t": 62.296,
   "dur": 5.445,
   "file": "vo/12.wav",
   "text": "The right sum is the twenty seven they paid, plus the three dollars they got back. Thirty, exactly."
  },
  {
   "t": 68.891,
   "dur": 2.501,
   "file": "vo/13.wav",
   "text": "Did the riddle fool you? Follow for more puzzles!"
  }
 ],
