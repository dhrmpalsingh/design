 "vo": [
  {
   "t": 0.35,
   "dur": 1.903,
   "file": "vo/00.wav",
   "text": "What if your house could float when a flood hits?"
  },
  {
   "t": 2.803,
   "dur": 3.431,
   "file": "vo/01.wav",
   "text": "First, lift it up, dig a deep pit underneath, and fill it with water."
  },
  {
   "t": 7.284,
   "dur": 2.667,
   "file": "vo/02.wav",
   "text": "Lower the house in... and it sinks straight to the bottom."
  },
  {
   "t": 10.901,
   "dur": 4.058,
   "file": "vo/03.wav",
   "text": "A house is heavy. To float, it has to push aside its own weight in water."
  },
  {
   "t": 15.609,
   "dur": 3.111,
   "file": "vo/04.wav",
   "text": "So, we give it a giant hollow concrete box to sit on."
  },
  {
   "t": 19.77,
   "dur": 4.923,
   "file": "vo/05.wav",
   "text": "It's mostly air inside, so it pushes aside a lot of water. Now the whole house floats!"
  },
  {
   "t": 25.543,
   "dur": 3.169,
   "file": "vo/06.wav",
   "text": "But when the family crowds onto one side, it starts to tip."
  },
  {
   "t": 29.662,
   "dur": 4.781,
   "file": "vo/07.wav",
   "text": "So the box gets split into tanks, and a pump moves water to the other side to level it out."
  },
  {
   "t": 35.393,
   "dur": 3.484,
   "file": "vo/08.wav",
   "text": "Next problem: wind and waves push it sideways, into the bank."
  },
  {
   "t": 39.627,
   "dur": 3.283,
   "file": "vo/09.wav",
   "text": "So two steel posts are driven deep down, into the bedrock."
  },
  {
   "t": 43.96,
   "dur": 4.37,
   "file": "vo/10.wav",
   "text": "Rings on the box slide along them. Up and down is fine, but never sideways."
  },
  {
   "t": 49.08,
   "dur": 3.468,
   "file": "vo/11.wav",
   "text": "And the water, power, and sewer pipes would snap the moment it lifts."
  },
  {
   "t": 53.398,
   "dur": 3.572,
   "file": "vo/12.wav",
   "text": "So they're swapped for flexible, coiled lines that stretch as it moves."
  },
  {
   "t": 57.72,
   "dur": 2.411,
   "file": "vo/13.wav",
   "text": "Now, when a flood comes, the water rises..."
  },
  {
   "t": 61.781,
   "dur": 4.607,
   "file": "vo/14.wav",
   "text": "and the house rises right along with it, floating safely, exactly where it was built."
  },
  {
   "t": 67.438,
   "dur": 3.591,
   "file": "vo/15.wav",
   "text": "Homes like this really exist, in the Netherlands. Follow for more!"
  }
 ],
