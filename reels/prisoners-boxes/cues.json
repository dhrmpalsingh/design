 "vo": [
  {
   "t": 0.35,
   "dur": 4.04,
   "file": "vo/00.wav",
   "text": "One hundred prisoners. One hundred boxes. And one very strange deal."
  },
  {
   "t": 5.04,
   "dur": 4.234,
   "file": "vo/01.wav",
   "text": "Each prisoner's number is hidden inside one of the boxes, shuffled at random."
  },
  {
   "t": 10.024,
   "dur": 4.67,
   "file": "vo/02.wav",
   "text": "One at a time, each prisoner may open fifty boxes, looking for their own number."
  },
  {
   "t": 15.444,
   "dur": 4.027,
   "file": "vo/03.wav",
   "text": "Then every box is closed again. No marks, no signals, no talking."
  },
  {
   "t": 20.121,
   "dur": 5.474,
   "file": "vo/04.wav",
   "text": "If every single prisoner finds their number, they all go free. If even one fails, nobody does."
  },
  {
   "t": 26.445,
   "dur": 3.944,
   "file": "vo/05.wav",
   "text": "Guessing at random, their chance is about one in a million trillion trillion."
  },
  {
   "t": 31.239,
   "dur": 2.582,
   "file": "vo/06.wav",
   "text": "Is there a better plan? Pause, and comment yours!"
  },
  {
   "t": 43.271,
   "dur": 3.519,
   "file": "vo/07.wav",
   "text": "Here's the trick. First, open the box with your own number on the lid."
  },
  {
   "t": 47.64,
   "dur": 4.572,
   "file": "vo/08.wav",
   "text": "Whatever number is inside, open that box next. And keep following the chain."
  },
  {
   "t": 53.062,
   "dur": 3.965,
   "file": "vo/09.wav",
   "text": "The boxes always form loops, so the chain must lead back to your own number."
  },
  {
   "t": 57.877,
   "dur": 2.665,
   "file": "vo/10.wav",
   "text": "Let's try it with eight boxes, and four tries each."
  },
  {
   "t": 61.192,
   "dur": 6.719,
   "file": "vo/11.wav",
   "text": "Prisoner three opens box three. Inside is six. Box six holds one. And box one holds three. Found it!"
  },
  {
   "t": 68.861,
   "dur": 4.424,
   "file": "vo/12.wav",
   "text": "That loop has three boxes, so everyone on it finds their number in three tries."
  },
  {
   "t": 74.035,
   "dur": 3.529,
   "file": "vo/13.wav",
   "text": "The plan only fails if some loop is longer than half the boxes."
  },
  {
   "t": 78.414,
   "dur": 4.352,
   "file": "vo/14.wav",
   "text": "With a hundred boxes, there's no loop that long about thirty one percent of the time."
  },
  {
   "t": 83.616,
   "dur": 3.298,
   "file": "vo/15.wav",
   "text": "So their chance jumps from almost zero, to thirty one percent!"
  },
  {
   "t": 88.164,
   "dur": 2.463,
   "file": "vo/16.wav",
   "text": "Would you trust the loop? Follow for more puzzles!"
  }
 ],
