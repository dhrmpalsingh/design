 "vo": [
  {
   "t": 0.35,
   "dur": 3.388,
   "file": "vo/00.wav",
   "text": "One hundred prisoners. One light bulb. Can they all walk free?"
  },
  {
   "t": 4.488,
   "dur": 3.883,
   "file": "vo/01.wav",
   "text": "Each prisoner is locked in a cell alone, and they can never talk to each other."
  },
  {
   "t": 9.021,
   "dur": 5.55,
   "file": "vo/02.wav",
   "text": "Every day, the warden picks one prisoner at random, and takes them to a room with a single light bulb."
  },
  {
   "t": 15.421,
   "dur": 3.793,
   "file": "vo/03.wav",
   "text": "The bulb starts off. Inside, they can flip the switch, or leave it alone."
  },
  {
   "t": 20.064,
   "dur": 4.102,
   "file": "vo/04.wav",
   "text": "On any day, any prisoner can announce: all one hundred of us have been in that room."
  },
  {
   "t": 24.916,
   "dur": 4.548,
   "file": "vo/05.wav",
   "text": "If they're right, everyone goes free. If they're wrong, everyone stays locked up forever."
  },
  {
   "t": 30.314,
   "dur": 2.718,
   "file": "vo/06.wav",
   "text": "Before day one, they get one meeting to make a plan."
  },
  {
   "t": 33.782,
   "dur": 2.343,
   "file": "vo/07.wav",
   "text": "What's your plan? Pause, and comment it below!"
  },
  {
   "t": 45.575,
   "dur": 3.454,
   "file": "vo/08.wav",
   "text": "Here's a plan that works. They pick one prisoner to be the counter."
  },
  {
   "t": 49.879,
   "dur": 4.396,
   "file": "vo/09.wav",
   "text": "Everyone else: the first time you find the bulb off, switch it on. Just once, ever."
  },
  {
   "t": 55.125,
   "dur": 4.135,
   "file": "vo/10.wav",
   "text": "Only the counter switches it off. And each time, they add one mark to the wall."
  },
  {
   "t": 60.11,
   "dur": 2.525,
   "file": "vo/11.wav",
   "text": "So a light that's on means: someone new has been here."
  },
  {
   "t": 63.285,
   "dur": 3.701,
   "file": "vo/12.wav",
   "text": "Say on day two, prisoner twenty three finds it off, and switches it on."
  },
  {
   "t": 67.736,
   "dur": 4.344,
   "file": "vo/13.wav",
   "text": "Day three, prisoner fifty eight finds it on. Not their signal, so they leave it."
  },
  {
   "t": 72.83,
   "dur": 4.216,
   "file": "vo/14.wav",
   "text": "Day four, the counter finds it on, switches it off, and makes mark number one."
  },
  {
   "t": 77.896,
   "dur": 4.311,
   "file": "vo/15.wav",
   "text": "And if twenty three ever finds it off again? They leave it. They've already been counted."
  },
  {
   "t": 82.957,
   "dur": 1.808,
   "file": "vo/16.wav",
   "text": "Day after day, the marks pile up."
  },
  {
   "t": 88.215,
   "dur": 4.199,
   "file": "vo/17.wav",
   "text": "When the counter reaches ninety nine marks, plus themselves, that's all one hundred."
  },
  {
   "t": 93.264,
   "dur": 2.348,
   "file": "vo/18.wav",
   "text": "They tell the warden... and everyone walks free!"
  },
  {
   "t": 97.462,
   "dur": 4.594,
   "file": "vo/19.wav",
   "text": "The catch? On average, this takes about ten thousand days. That's twenty eight years!"
  },
  {
   "t": 103.106,
   "dur": 2.58,
   "file": "vo/20.wav",
   "text": "Could you wait that long? Follow for more puzzles!"
  }
 ],
 "countdown": [
