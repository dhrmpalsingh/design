 "vo": [
  {
   "t": 0.35,
   "dur": 4.177,
   "file": "vo/00.wav",
   "text": "You're on a game show. Behind one door is a car. Behind the other two, goats."
  },
  {
   "t": 5.177,
   "dur": 1.214,
   "file": "vo/01.wav",
   "text": "You pick door number one."
  },
  {
   "t": 7.141,
   "dur": 3.713,
   "file": "vo/02.wav",
   "text": "The host, who knows where the car is, opens door three. It's a goat!"
  },
  {
   "t": 11.704,
   "dur": 2.743,
   "file": "vo/03.wav",
   "text": "Now the host asks: do you want to switch to door two?"
  },
  {
   "t": 15.097,
   "dur": 3.781,
   "file": "vo/04.wav",
   "text": "Stay, or switch? Does it even matter? Pause, and comment your answer!"
  },
  {
   "t": 28.528,
   "dur": 2.743,
   "file": "vo/05.wav",
   "text": "You should switch! Switching wins two times out of three."
  },
  {
   "t": 32.121,
   "dur": 3.084,
   "file": "vo/06.wav",
   "text": "When you first picked, you had a one in three chance of being right."
  },
  {
   "t": 35.955,
   "dur": 4.001,
   "file": "vo/07.wav",
   "text": "So two times out of three, the car was behind one of the other two doors."
  },
  {
   "t": 40.706,
   "dur": 6.981,
   "file": "vo/08.wav",
   "text": "The host always opens a goat door, never the car. So if your first pick was wrong, the car is behind the door that's left."
  },
  {
   "t": 48.537,
   "dur": 2.897,
   "file": "vo/09.wav",
   "text": "Still not sure? Imagine a hundred doors. You pick one."
  },
  {
   "t": 52.084,
   "dur": 5.162,
   "file": "vo/10.wav",
   "text": "The host opens ninety eight goat doors, and skips just one. Would you stay, or take that door?"
  },
  {
   "t": 58.096,
   "dur": 5.812,
   "file": "vo/11.wav",
   "text": "We played the game a thousand times. Staying won about a third of the games. Switching won about two thirds."
  },
  {
   "t": 65.158,
   "dur": 2.249,
   "file": "vo/12.wav",
   "text": "Would you have switched? Follow for more puzzles!"
  }
 ],
