 "vo": [
  {
   "t": 0.35,
   "dur": 3.029,
   "file": "vo/00.wav",
   "text": "Four friends are stuck on the wrong side of a canyon, at night."
  },
  {
   "t": 4.029,
   "dur": 4.234,
   "file": "vo/01.wav",
   "text": "The old bridge holds only two people at a time, and they have just one torch."
  },
  {
   "t": 9.013,
   "dur": 4.144,
   "file": "vo/02.wav",
   "text": "No one can cross without the torch, so someone has to carry it back each time."
  },
  {
   "t": 13.907,
   "dur": 6.154,
   "file": "vo/03.wav",
   "text": "They cross at different speeds: one, two, five, and ten minutes. A pair moves at the slower person's pace."
  },
  {
   "t": 20.911,
   "dur": 3.267,
   "file": "vo/04.wav",
   "text": "In seventeen minutes, the bridge collapses. Can they all make it?"
  },
  {
   "t": 24.828,
   "dur": 1.495,
   "file": "vo/05.wav",
   "text": "Pause, and comment your plan!"
  },
  {
   "t": 36.173,
   "dur": 3.794,
   "file": "vo/06.wav",
   "text": "Most people let the fastest friend walk everyone across, one by one."
  },
  {
   "t": 40.617,
   "dur": 4.738,
   "file": "vo/07.wav",
   "text": "Ten, plus one, plus five, plus one, plus two. That's nineteen minutes. Too slow!"
  },
  {
   "t": 46.405,
   "dur": 3.76,
   "file": "vo/08.wav",
   "text": "The trick: send the two slowest across together, so their times overlap."
  },
  {
   "t": 51.015,
   "dur": 1.983,
   "file": "vo/09.wav",
   "text": "First, one and two cross. Two minutes."
  },
  {
   "t": 53.848,
   "dur": 2.185,
   "file": "vo/10.wav",
   "text": "One brings the torch back. Three minutes."
  },
  {
   "t": 56.883,
   "dur": 2.819,
   "file": "vo/11.wav",
   "text": "Now five and ten cross together. Thirteen minutes."
  },
  {
   "t": 60.752,
   "dur": 2.266,
   "file": "vo/12.wav",
   "text": "Two brings the torch back. Fifteen minutes."
  },
  {
   "t": 63.868,
   "dur": 2.826,
   "file": "vo/13.wav",
   "text": "And one and two cross again. Seventeen minutes, exactly!"
  },
  {
   "t": 67.544,
   "dur": 2.32,
   "file": "vo/14.wav",
   "text": "Everyone's safe, just as the bridge falls."
  },
  {
   "t": 71.714,
   "dur": 2.611,
   "file": "vo/15.wav",
   "text": "Did you get seventeen? Follow for more puzzles!"
  }
 ],
