 "vo": [
  {
   "t": 0.35,
   "dur": 2.287,
   "file": "vo/00.wav",
   "text": "The warden offers one hundred prisoners a deal."
  },
  {
   "t": 3.387,
   "dur": 5.726,
   "file": "vo/01.wav",
   "text": "Tomorrow, they'll stand in one long line, all facing forward, and each one gets a red or a blue hat."
  },
  {
   "t": 9.963,
   "dur": 4.033,
   "file": "vo/02.wav",
   "text": "Nobody can see their own hat. Only the hats of everyone in front of them."
  },
  {
   "t": 14.746,
   "dur": 3.458,
   "file": "vo/03.wav",
   "text": "Starting at the back, each prisoner says one word: red, or blue."
  },
  {
   "t": 19.054,
   "dur": 4.01,
   "file": "vo/04.wav",
   "text": "Name your own hat color, and you walk free. Get it wrong, and you stay locked up."
  },
  {
   "t": 23.914,
   "dur": 3.566,
   "file": "vo/05.wav",
   "text": "Everyone hears every answer, but no one can say anything else."
  },
  {
   "t": 28.13,
   "dur": 3.059,
   "file": "vo/06.wav",
   "text": "Tonight, they can make a plan. How many can they save for sure?"
  },
  {
   "t": 31.939,
   "dur": 2.343,
   "file": "vo/07.wav",
   "text": "What's your plan? Pause, and comment it below!"
  },
  {
   "t": 43.732,
   "dur": 3.753,
   "file": "vo/08.wav",
   "text": "Here's the trick. The prisoner at the back counts the red hats in front of them."
  },
  {
   "t": 48.335,
   "dur": 3.398,
   "file": "vo/09.wav",
   "text": "If the number is even, they say blue. If it's odd, they say red."
  },
  {
   "t": 52.783,
   "dur": 3.551,
   "file": "vo/10.wav",
   "text": "For them, it's a coin flip. But now everyone else knows the code."
  },
  {
   "t": 57.084,
   "dur": 1.689,
   "file": "vo/11.wav",
   "text": "Let's try it with five prisoners."
  },
  {
   "t": 59.623,
   "dur": 3.905,
   "file": "vo/12.wav",
   "text": "The back prisoner sees two red hats. Two is even, so they say: blue."
  },
  {
   "t": 64.478,
   "dur": 4.048,
   "file": "vo/13.wav",
   "text": "Their own hat is red, so they lose the coin flip. That's the price of the code."
  },
  {
   "t": 69.276,
   "dur": 7.076,
   "file": "vo/14.wav",
   "text": "Next in line sees only one red hat. That's odd, but the code said even. So the missing red is on their own head. Red!"
  },
  {
   "t": 77.202,
   "dur": 4.877,
   "file": "vo/15.wav",
   "text": "From here, each prisoner adds the reds they've heard behind them to the reds they can see ahead."
  },
  {
   "t": 82.829,
   "dur": 4.142,
   "file": "vo/16.wav",
   "text": "If even or odd matches the code, their hat is blue. If it doesn't, it's red."
  },
  {
   "t": 87.821,
   "dur": 2.456,
   "file": "vo/17.wav",
   "text": "Blue. Red. Blue. Every one of them is right."
  },
  {
   "t": 91.427,
   "dur": 2.721,
   "file": "vo/18.wav",
   "text": "With a hundred prisoners, it works exactly the same."
  },
  {
   "t": 95.798,
   "dur": 5.149,
   "file": "vo/19.wav",
   "text": "Ninety nine walk free, guaranteed. And the one at the back still has a fifty-fifty chance."
  },
  {
   "t": 102.597,
   "dur": 3.355,
   "file": "vo/20.wav",
   "text": "Would you volunteer to stand at the back? Follow for more puzzles!"
  }
 ],
 "countdown": [
  32.039,
